<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Laravel API, Sanctum, health probes, email verification
    RewriteCond %{REQUEST_URI} ^/api/ [OR]
    RewriteCond %{REQUEST_URI} ^/sanctum/ [OR]
    RewriteCond %{REQUEST_URI} ^/email/verify/ [OR]
    RewriteCond %{REQUEST_URI} ^/health$ [OR]
    RewriteCond %{REQUEST_URI} ^/ready$ [OR]
    RewriteCond %{REQUEST_URI} ^/startup$ [OR]
    RewriteCond %{REQUEST_URI} ^/live$ [OR]
    RewriteCond %{REQUEST_URI} ^/up$
    RewriteRule ^ index.php [L]

    # Existing static files / directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # SPA fallback
    RewriteRule ^ index.html [L]
</IfModule>

DirectoryIndex index.html index.php

# Force correct JS/CSS MIME types (Hostinger/LiteSpeed can otherwise serve
# application/octet-stream, which browsers reject for ES modules).
<IfModule mod_mime.c>
    AddType application/javascript .js .mjs
    AddType text/css .css
    AddType application/wasm .wasm
    AddType application/manifest+json .webmanifest
</IfModule>

# Let Hostinger's CDN absorb brief shared-host load spikes while browsers still
# revalidate the SPA shell. Deployments preserve prior content-hashed assets,
# so a shell held at the edge for up to 60 seconds remains safe.
<IfModule mod_headers.c>
    <Files "index.html">
        Header always set Cache-Control "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        Header always set Pragma ""
        Header always unset Expires
    </Files>
    <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>
</IfModule>

# Deny sensitive files if ever placed in public_html
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
