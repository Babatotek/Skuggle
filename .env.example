# Browser configuration. Values prefixed with VITE_ are public after build.
VITE_APP_NAME="Skuggle"
VITE_ENVIRONMENT="development"
VITE_SUPPORT_EMAIL="support@skuggle.com"
VITE_LIVE_API="true"
# Local/demo only — never set true for production Hostinger builds.
VITE_ENABLE_DEMO="false"
# Suspended by default — set true only after Google Cloud OAuth credentials are ready
VITE_GOOGLE_OAUTH_ENABLED="false"
VITE_API_URL="/api/v1"
VITE_CSRF_URL="/sanctum/csrf-cookie"

# GEMINI_API_KEY: Optional for AI lesson/quiz endpoints on the Node server.
GEMINI_API_KEY=

# APP_URL: Frontend origin (must match Sanctum stateful domains).
APP_URL="http://127.0.0.1:3000"

# Laravel (XAMPP MySQL + php artisan serve)
SKOOL_BACKEND_URL="http://127.0.0.1:8000"
